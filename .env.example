# Neon para endpoints server-side. Guardar como secreto en Vercel.
DATABASE_URL="tu_url_de_base_de_datos"

# Gemini solo en servidor. No agregar prefijo VITE_.
GEMINI_API_KEY="tu_clave_de_google_ai_studio"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Variable usada actualmente por módulos del frontend; VITE_ la hace pública.
# No quitar hasta migrar esos módulos a endpoints server-side.
VITE_NEON_DATABASE_URL="tu_url_de_base_de_datos"

# Microsoft Entra ID (Azure AD) - UNID Single Tenant
VITE_AZURE_CLIENT_ID="tu_client_id_aqui"
VITE_AZURE_TENANT_ID="tu_tenant_id_aqui"

# Lista blanca de IPs para acceso de desarrollador (opcional, separadas por coma)
VITE_ALLOWED_DEV_IPS=""
ALLOWED_DEV_IPS=""
